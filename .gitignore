# Ignore everything by default; this folder contains unrelated shop/boat files too.
*

# Track the DXF Prep app.
!classify_dxf.py
!dxf_prep_app.py
!test_classify_dxf.py
!Run DXF Prep.bat
!dxf_prep_icon.ico
!dxf_prep_icon.png
!README.md
!LICENSE
!.gitignore
!Build DXF Prep EXE.bat

# Keep local settings, generated DXFs, caches, and snapshots out of source control.
dxf_prep_settings.json
*.dxf
*.DXF
__pycache__/
Stable Snapshots/

# Isolated Flutter UI evaluation (SDK and build outputs stay local).
!flutter_workbench/
!flutter_workbench/**/
!flutter_workbench/**
flutter_workbench/.dart_tool/
flutter_workbench/.idea/
flutter_workbench/build/
flutter_workbench/*.iml
flutter_workbench/windows/flutter/ephemeral/
flutter_workbench/**/__pycache__/
flutter_workbench/backend/user_state/
flutter_workbench/backend/snapshots/
!Run Flutter Prototype.bat
!Run Flutter Prototype Windows.bat
!Run Flutter Development.bat
