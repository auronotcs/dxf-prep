# Code lives in dxf_prep\, letter_mounting\, cam_probes\ and nesting-lab\.
# Shop data lives in Documents\Shop Jobs and old copies in Documents\Archive,
# so this is an ordinary ignore list. Folders below are local-only.

# Python and build output
__pycache__/
*.py[cod]
build/
dist/
.build_tools/
.cache/

# Vendored libraries (large; installed locally, not in git)
letter_mounting/holegen_libs/
.holegen-deps/
holegen_deps/

# Generated icon sets and scratch output
letter_mounting/mounting-workflow-icons/
icon-concepts/
test_artifacts/
tmp/
*-smoke-recovery.json

# Local settings
dxf_prep/dxf_prep_settings.json

# Personal and shop folders that stay out of git
Boat Designs/
Organization Records/
Letter Mounting Test Files/
.codex-remote-attachments/
.flutter-sdk/

# Separate project; not part of this repository yet
cnc-explorer-preview/

# Shop data that might be dropped here by mistake. Small, named test inputs
# are listed as exceptions.
*.dxf
*.DXF
!letter_mounting/Keyhole example.dxf
!letter_mounting/test_fixtures/*.dxf
*.camjob.json
*.cnc
*.nc
*.plt
*.eps
*.pdf

# Retired Flutter copy (now in the CAM Workbench repository under flutter\)
flutter_workbench/.dart_tool/
flutter_workbench/.idea/
flutter_workbench/build/
flutter_workbench/*.iml
flutter_workbench/windows/flutter/ephemeral/
flutter_workbench/backend/user_state/
flutter_workbench/backend/snapshots/
